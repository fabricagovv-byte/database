{
  "realm": "cvm",
  "enabled": true,
  "displayName": "CVM — IdP simulado",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "pt-BR"
  ],
  "defaultLocale": "pt-BR",
  "sslRequired": "external",
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername",
  "otpPolicyType": "totp",
  "roles": {
    "realm": [
      {
        "name": "cvm_gestor",
        "description": "Gestor do contrato na CVM"
      },
      {
        "name": "cvm_fiscal",
        "description": "Fiscal técnico/administrativo da CVM"
      },
      {
        "name": "cvm_usuario",
        "description": "Usuário departamental da CVM"
      },
      {
        "name": "broker_operador",
        "description": "Operador da contratada"
      },
      {
        "name": "broker_admin",
        "description": "Administrador da contratada"
      },
      {
        "name": "auditor",
        "description": "Auditor (somente leitura)"
      }
    ]
  },
  "clients": [
    {
      "clientId": "broker-portal",
      "name": "Portal CVM",
      "publicClient": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:5173"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "broker-api",
      "name": "API do Broker",
      "bearerOnly": true
    }
  ],
  "users": [
    {
      "username": "cvm.gestor",
