# Copie para .env e preencha. Nunca coloque este arquivo no git.
POSTGRES_PASSWORD=troque-esta-senha
# gere com: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CT_CHAVE_CRIPTO=
# true quando estiver atrás de HTTPS
CT_COOKIE_SEGURO=false
# false = só o administrador cria contas (o primeiro cadastro vira admin)
CT_CADASTRO_ABERTO=true
CT_INTERVALO_COTACOES=60

# --- fontes opcionais (sem elas o sistema usa Yahoo, Binance e AwesomeAPI, que não pedem chave) ---
BRAPI_TOKEN=
ALPHAVANTAGE_KEY=
# Aliyun Machine Translation (tradução PT→chinês para buscar no 1688)
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 1688 / Alibaba Open Platform (precisa de app aprovado em open.1688.com)
ALIBABA_APP_KEY=
ALIBABA_APP_SECRET=

# --- avisos ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
